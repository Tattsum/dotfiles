{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$HOME/.local/bin/agent-bash-guard\" && \"$HOME/.local/bin/agent-bash-guard\" --agent codex || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
