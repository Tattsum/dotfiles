layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="ai" focus=true {
        pane split_direction="vertical" {
            pane focus=true name="Implement"
            pane size="35%" name="Review"
        }
    }

    // hx を浮動ペインにしない: yazi-picker の toggle-floating-panes で hx ごと隠れ、`:open` の入力が AI ペインへ流れる。
    tab name="editor" {
        pane name="Editor" {
            command "hx"
        }
    }
}

