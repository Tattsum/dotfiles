[url "ssh://git@github.com"]
	insteadOf = https://github.com

[user]
	name = tattsum
	email = kurohari35@gmail.com
	signingkey = ssh-rsa 

[core]
	excludesfile = ~/.gitignore_global

[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
