<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tatsuma.kano.brew-maintenance</string>

    <!-- plist は $HOME や ~ を展開せず、誤ったパスを書いても無言で失敗する。zsh を挟んで
         シェルに展開させることで、ユーザー名のハードコードを避けている（この repo は public）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>exec "$HOME/.local/bin/brew-maintenance"</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- StandardOutPath / StandardErrorPath は指定しない。同じくパス展開が効かないため、
         ログの宛先はスクリプト側の exec リダイレクトに一本化している。 -->
</dict>
</plist>
