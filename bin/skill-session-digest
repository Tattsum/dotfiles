#!/usr/bin/env bash

# Claude Code / Cursor / Codex のセッションログを共通レコードへ正規化し、
# 日報生成用の軽量 JSON に集約する。判断や要約は持ち込まず、観測事実だけを扱う。
#
# 3ソースを別々の digest に分けず 1 本のレコード列へ正規化するのは、同じリポジトリを
# 別エージェントで触った日に、日報側で突合させる作業が発生するため。git トップレベルで
# 畳めば 1 プロジェクトに収まる。代わりにソース毎の時刻精度が揃わないので、レコードに
# precision を持たせて projects[].time_precision として出す（捨てると Cursor の粗い時刻が
# Claude の event 時刻と同じ顔で並ぶ）。
#
# 圧縮しない選択は取れない。実測（2026-08-20）で 1 日分の生データは prompt 141 件
# 567KB ＋ tool_use 1,194 件 335KB あり、そのままモデルに渡すとコンテキストに乗らない。
# prompt を 1000 字で切り詰め、tool_use をプロジェクト単位に集約して約 40KB にする。
#
# mtime での事前フィルタはしない。全 1,205 ファイル 478MB を舐めても実測 3 秒台で、
# プレフィルタ有無の差は 2.4 秒しかない。corpus は保持期間（実測約 32 日）で頭打ちに
# なるため、将来も増え続けない。
#
# サブエージェントの記録は全ソースで除外する（Claude の `agent-*.jsonl`、Cursor の
# `subagents/` と composerHeaders.isSubagent、Codex の parent_thread_id / agent_path /
# session_meta.source がオブジェクトの行）。日報の主語は人間の作業であり、
# サブエージェント内部のツール実行まで数えると tool 集計が実態から乖離する。
#
# Usage:
#   skill-session-digest [YYYY-MM-DD] [options]   # 詳細は --help
#
# Output: stdout に JSON 1 オブジェクト（meta.schema_version = 2）
#
# 出力にはリポジトリ名・ブランチ名・プロンプト本文がそのまま含まれる。business 文脈では
# 顧客名・案件名を含むため、リポジトリ内に書き出さないこと（呼び出し側の責務）。
# この dotfiles は public なので特に注意する。

set -euo pipefail

SOURCE="all"
DAY=""
PROJECT=""
MAX_PROMPT_CHARS=1000
CLAUDE_ROOT="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
CURSOR_ROOT="${CURSOR_CONFIG_DIR:-$HOME/.cursor}/projects"
CURSOR_STATE_DB="$HOME/Library/Application Support/Cursor/User/globalStorage/state.vscdb"
CODEX_ROOT="${CODEX_HOME:-$HOME/.codex}/sessions"

usage() {
  command cat <<'USAGE'
Usage:
  skill-session-digest [YYYY-MM-DD] [options]

Options:
  --source <all|claude|cursor|codex>  Sources to collect (default: all)
  --project <substring>               Filter normalized project paths
  --root <dir>                        Alias for --claude-root
  --claude-root <dir>                 Claude Code project log root
  --cursor-root <dir>                 Cursor agent transcript root
  --cursor-state-db <file>            Cursor state.vscdb path
  --codex-root <dir>                  Codex rollout log root
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --source) SOURCE="${2:-}"; shift 2 ;;
    --project) PROJECT="${2:-}"; shift 2 ;;
    --root|--claude-root) CLAUDE_ROOT="${2:-}"; shift 2 ;;
    --cursor-root) CURSOR_ROOT="${2:-}"; shift 2 ;;
    --cursor-state-db) CURSOR_STATE_DB="${2:-}"; shift 2 ;;
    --codex-root) CODEX_ROOT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) DAY="$1"; shift ;;
  esac
done

case "$SOURCE" in
  all|claude|cursor|codex) ;;
  *) echo "source must be all, claude, cursor, or codex: $SOURCE" >&2; exit 2 ;;
esac

[ -n "$DAY" ] || DAY="$(date +%Y-%m-%d)"
case "$DAY" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
  *) echo "date must be YYYY-MM-DD: $DAY" >&2; exit 2 ;;
esac

PREV_DAY="$(date -j -v-1d -f '%Y-%m-%d' "$DAY" +%Y-%m-%d)"

TZ_NAME="$(date +%Z)"
TZ_OFFSET="$(date +%z)"
OFFSET_SECONDS=$(( ${TZ_OFFSET:0:1}1 * ( 10#${TZ_OFFSET:1:2} * 3600 + 10#${TZ_OFFSET:3:2} * 60 ) ))

RECORDS="$(mktemp -t skill-session-digest-records)"
SOURCE_STATS="$(mktemp -t skill-session-digest-stats)"
WARNINGS="$(mktemp -t skill-session-digest-warnings)"
trap 'rm -f "$RECORDS" "$SOURCE_STATS" "$WARNINGS"' EXIT

short_path() {
  case "$1" in
    "$HOME"*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

selected() {
  [ "$SOURCE" = "all" ] || [ "$SOURCE" = "$1" ]
}

add_warning() {
  jq -Rn --arg message "$1" '$message' >> "$WARNINGS"
}

add_source_stat() {
  jq -nc \
    --arg source "$1" --arg root "$(short_path "$2")" --arg status "$3" \
    --argjson files "$4" --argjson records "$5" --arg precision "$6" \
    --arg oldest "$7" \
    '{source: $source, root: $root, status: $status, files_scanned: $files,
      records: $records, time_precision: $precision, retention_oldest: $oldest}' \
    >> "$SOURCE_STATS"
}

# records から `k == "a"`（セッションタイトル）を除くのは、タイトルが日付に依存せず
# 全セッション分積まれるため。含めると対象日の記録が 0 件のソースでも records が非0に
# なり（実測: 対象日外の Cursor セッション 200 件で records 200）、「集計できていない
# ソース」の判定にこの数値を使えない。
day_record_count() {
  jq -s '[.[] | select(.k != "a")] | length' "$RECORDS"
}

# 対象日に更新されたログファイルの数。available なソースが 0 件だったとき、それが
# 「その日は使っていない」なのか「形式が変わって拾えていない」なのかを分ける唯一の手掛かり。
# 前者で毎日 warning を出すと、warnings 自体が読み飛ばされる。
files_touched_on_day() {
  local root="$1"
  local pattern="$2"

  # 下限を前日 23:59:59 にするのは、`-newermt` が「厳密に新しい」判定で、
  # mtime がちょうど 00:00:00 のファイルを落とすため（実測で検出漏れを確認）。
  # 前日の最後の 1 秒を巻き込むが、この件数は「当日ログの有無」の目安にしか使わない。
  command find "$root" -type f -name "$pattern" \
    -newermt "$PREV_DAY 23:59:59" ! -newermt "$DAY 23:59:59" 2>/dev/null | wc -l | tr -d ' '
}

oldest_file_date() {
  local root="$1"
  local pattern="$2"
  local oldest_epoch

  oldest_epoch="$(command find "$root" -type f -name "$pattern" -exec stat -f '%m' {} + 2>/dev/null \
    | sort -n | head -1 || true)"
  if [ -n "$oldest_epoch" ]; then
    date -r "$oldest_epoch" +%Y-%m-%d
  else
    printf 'unknown'
  fi
}

# nippo（nwiizo/nippo, MIT）の NOISE_PREFIXES を vendoring。ロジックは前方一致で自明だが、
# リストそのものが 5 ヶ月分の観測の蓄積で、自作の素朴な版より 27% 多くノイズを落とす（実測）。
# `[Image:` だけ上流の `[Image: source:` から広げてある。実測ログには
# `[Image: original 3600x2338, ...` という別形式があり、上流の前方一致では素通りする。
NOISE_PREFIXES='[
  "<command-name>", "<command-message>", "<command-args>",
  "<task-notification>", "<local-command-caveat>", "<local-command-stdout>",
  "<bash-input>", "<bash-stdout>",
  "[Image #", "[Image:", "[Request interrupted by user]",
  "This session is being continued from a previous conversation",
  "Base directory for this skill:", "(Re-invocation of /"
]'

extract_claude() {
  local files before after oldest

  [ -d "$CLAUDE_ROOT" ] || {
    add_warning "Claude log root not found: $(short_path "$CLAUDE_ROOT")"
    add_source_stat "claude" "$CLAUDE_ROOT" "missing" 0 0 "event" "unknown"
    return
  }

  files="$(command find "$CLAUDE_ROOT" -type f -name '*.jsonl' ! -name 'agent-*' | wc -l | tr -d ' ')"
  oldest="$(oldest_file_date "$CLAUDE_ROOT" '*.jsonl')"
  before="$(day_record_count)"

  # `awk 1` を挟むのは末尾改行の無いファイル対策。複数ファイルを 1 つの jq プロセスに
  # 渡すと、末尾改行が無いファイルの最終行と次ファイルの先頭行が連結して 1 レコード
  # 消える（実測で再現済み・現状 0/1205 だが潜在）。`fromjson?` は壊れた行のスキップ用で、
  # これが無いと 1 行の破損で jq が exit 1 し、残り全ファイルがサイレントに欠落する。
  while IFS= read -r -d '' file; do
    awk 1 "$file"
  done < <(command find "$CLAUDE_ROOT" -type f -name '*.jsonl' ! -name 'agent-*' -print0) \
    | jq -c -R --argjson off "$OFFSET_SECONDS" --arg day "$DAY" '
        def localpart($fmt): (.[0:19] + "Z" | fromdateiso8601 + $off | strftime($fmt));
        fromjson? // empty
        | select(type == "object")
        | if .type == "ai-title" then
            {k: "a", source: "claude", sid: (.sessionId // ""), title: (.aiTitle // "")}
          elif (.timestamp | type) != "string" then empty
          elif (.timestamp | localpart("%Y-%m-%d")) != $day then empty
          elif .type == "user" and (.isSidechain != true) and (.userType == "external") then
            (if (.message.content | type) == "string" then .message.content
             else [.message.content[]? | select(.type == "text") | .text // ""] | join("\n")
             end) as $text
            | select(($text | type) == "string" and ($text | length) > 0)
            | {k: "p", source: "claude", precision: "event",
               time: (.timestamp | localpart("%H:%M")), hour: (.timestamp | localpart("%H")),
               cwd: (.cwd // ""), br: (.gitBranch // ""), sid: (.sessionId // ""), text: $text}
          elif .type == "assistant" then
            {source: "claude", precision: "event", cwd: (.cwd // ""), sid: (.sessionId // ""),
             time: (.timestamp | localpart("%H:%M")), hour: (.timestamp | localpart("%H"))} as $ctx
            | .message.content[]? | select(.type == "tool_use")
            | $ctx + {k: "t", name: (.name // "?"),
                      arg: (.input.command // .input.file_path // .input.skill // .input.pattern // "")}
          else empty end
      ' >> "$RECORDS"

  after="$(day_record_count)"
  add_source_stat "claude" "$CLAUDE_ROOT" "available" "$files" "$((after - before))" "event" "$oldest"
}

# Cursor の transcript は発話単位の timestamp を持たない。cwd・タイトル・時刻は
# state.vscdb 側にしか無いため、SQLite を引く以外に突合手段が無い。Cursor 起動中でも
# 触らないよう `-readonly` を付ける（書き込みロックを取ると Cursor 側が壊れうる）。
# DB が無い・読めない場合に中断しないのは、transcript の mtime でも「その日に作業した」
# という日報に必要な事実は残るため。精度が落ちたことは precision と warnings で伝える。
cursor_metadata() {
  local output="$1"
  local rows

  if [ ! -f "$CURSOR_STATE_DB" ]; then
    add_warning "Cursor metadata DB not found; transcript file times will be used"
    printf '{}\n' > "$output"
    return
  fi

  rows="$(mktemp -t skill-session-digest-cursor-rows)"
  if ! sqlite3 -readonly -json "$CURSOR_STATE_DB" \
      'SELECT composerId, createdAt, lastUpdatedAt, value FROM composerHeaders WHERE COALESCE(isSubagent, 0) = 0;' \
      > "$rows" 2>/dev/null; then
    add_warning "Cursor metadata DB could not be read; transcript file times will be used"
    printf '{}\n' > "$output"
    rm -f "$rows"
    return
  fi

  # 時刻の無い行は map から落とす。突合できなかった transcript として file 精度へ
  # 縮退するので、Cursor 全体を捨てずに済む。jq 自体の失敗も潰して続行するのは、
  # 1 行の異常データが set -e で digest 全体を殺し、Cursor だけでなく Claude / Codex の
  # 集計まで失われるため（実測: createdAt が NULL の行 1 件で exit 5・出力ゼロ）。
  # ヘッダの `fromjson?` と同じ方針で、壊れた入力は落として残りを出す。
  if ! jq '
    map(. as $row
      | (($row.value | fromjson?) // {}) as $value
      | (($row.lastUpdatedAt // 0) as $updated
         | if $updated > 0 then $updated else ($row.createdAt // 0) end) as $millis
      | select($millis > 0)
      | {key: $row.composerId,
         value: {
           epoch: ($millis / 1000 | floor),
           cwd: ($value.workspaceIdentifier.uri.fsPath // ""),
           title: ($value.name // "")
         }})
    | from_entries
  ' "$rows" > "$output" 2>/dev/null; then
    add_warning "Cursor metadata could not be parsed; transcript file times will be used"
    printf '{}\n' > "$output"
  fi
  rm -f "$rows"
}

extract_cursor() {
  local files before after oldest metadata plan file sid epoch cwd title precision unmatched

  [ -d "$CURSOR_ROOT" ] || {
    add_warning "Cursor log root not found: $(short_path "$CURSOR_ROOT")"
    add_source_stat "cursor" "$CURSOR_ROOT" "missing" 0 0 "session-or-file" "unknown"
    return
  }

  files="$(command find "$CURSOR_ROOT" -type f -name '*.jsonl' -path '*/agent-transcripts/*' ! -path '*/subagents/*' | wc -l | tr -d ' ')"
  oldest="$(oldest_file_date "$CURSOR_ROOT" '*.jsonl')"
  before="$(day_record_count)"
  metadata="$(mktemp -t skill-session-digest-cursor-meta)"
  cursor_metadata "$metadata"
  unmatched=0

  # 対象日のセッションだけを 1 回の jq で選び出す。transcript ごとに jq / date /
  # basename / dirname を起こす素直な書き方では、同じファイル数で Claude の約 7 倍
  # かかった（実測 200 本で 4.10s 対 0.57s。Claude は全ファイルを 1 プロセスで流す）。
  # 突合できない transcript の時刻はファイルの mtime なので、find -exec stat で
  # まとめて取ってから metadata と突き合わせる。
  # 区切りに @tsv ではなく \u001f を使うのは、@tsv がタブと改行をエスケープして出すため。
  # パスにタブが含まれると、読み戻した側では元の文字に戻せない。
  plan="$(mktemp -t skill-session-digest-cursor-plan)"
  command find "$CURSOR_ROOT" -type f -name '*.jsonl' -path '*/agent-transcripts/*' \
      ! -path '*/subagents/*' -exec stat -f '%m %N' {} + 2>/dev/null \
    | jq -R -s -r --slurpfile metafile "$metadata" --argjson off "$OFFSET_SECONDS" --arg day "$DAY" '
        ($metafile[0] // {}) as $metamap
        | split("\n") | map(select(length > 0))
        | map((index(" ")) as $sp
              | {mtime: (.[0:$sp] | tonumber), path: .[$sp + 1:]}
              | .sid = (.path | split("/") | last | sub("\\.jsonl$"; ""))
              | ("cursor://" + (.path | split("/") | .[-4])) as $fallback
              | ($metamap[.sid] // null) as $meta
              | if $meta == null then
                  . + {epoch: .mtime, cwd: $fallback, title: "", precision: "file"}
                else
                  . + {epoch: $meta.epoch, title: ($meta.title // ""), precision: "session",
                       cwd: (if ($meta.cwd // "") == "" then $fallback else $meta.cwd end)}
                end)
        | map(select((.epoch + $off | strftime("%Y-%m-%d")) == $day))
        | .[] | [(.epoch | tostring), .precision, .cwd, .title, .path] | join("\u001f")
      ' > "$plan"

  # 突合できた場合もセッション単位の 1 時刻しか無く、発話毎の時刻は復元できない。
  # それらしい時刻を按分して埋めると Claude の event 時刻と区別が付かなくなるので、
  # セッション時刻をそのまま全レコードに配り precision で区別する。
  while IFS=$'\x1f' read -r epoch precision cwd title file; do
    # unmatched は対象日のものだけ数える。警告は「この日の時刻が粗い」ことを伝えるもので、
    # 過去の突合できないセッションまで数えると毎日同じ警告が出て読まれなくなる。
    if [ "$precision" = "file" ]; then
      unmatched=$((unmatched + 1))
    fi

    sid="${file##*/}"
    sid="${sid%.jsonl}"
    jq -nc --arg sid "$sid" --arg title "$title" \
      '{k: "a", source: "cursor", sid: $sid, title: $title}' >> "$RECORDS"

    awk 1 "$file" \
      | jq -c -R --argjson epoch "$epoch" --argjson off "$OFFSET_SECONDS" \
          --arg cwd "$cwd" --arg sid "$sid" --arg precision "$precision" '
          def localpart($fmt): ($epoch + $off | strftime($fmt));
          fromjson? // empty
          | if .role == "user" then
              (if (.message.content | type) == "string" then .message.content
               else [.message.content[]? | select(.type == "text") | .text // ""] | join("\n") end) as $text
              | select(($text | type) == "string" and ($text | length) > 0)
              | {k: "p", source: "cursor", precision: $precision, time: localpart("%H:%M"), hour: "",
                 cwd: $cwd, br: "", sid: $sid, text: $text}
            elif .role == "assistant" then
              .message.content[]? | select(.type == "tool_use")
              | {k: "t", source: "cursor", precision: $precision, time: localpart("%H:%M"), hour: "",
                 cwd: $cwd, sid: $sid, name: (.name // "?"),
                 arg: (.input.command // .input.file_path // .input.skill // .input.pattern // "")}
            else empty end
        ' >> "$RECORDS"
  done < "$plan"

  if [ "$unmatched" -gt 0 ]; then
    add_warning "Cursor metadata did not match $unmatched transcript(s); file times were used"
  fi
  rm -f "$metadata" "$plan"
  after="$(day_record_count)"
  add_source_stat "cursor" "$CURSOR_ROOT" "available" "$files" "$((after - before))" "session-or-file" "$oldest"
}

# 形式変更の検知に使う「その rollout が発話行を持つか」。日付で絞らないのは、日を跨いだ
# セッション（前日に発話・当日はツールだけ）と text 要素を持たない発話（画像のみ）で
# 誤発火するため（どちらも実測で再現）。日単位の件数では逆に、移行日に旧形式ファイルの
# 当日発話が新形式ファイルの沈黙を隠して見逃す。発話行を 1 つも持たない rollout だけが
# 形式変更の像なので、判定はファイル単位・日付非依存で行う。
codex_prompt_lines() {
  jq -s '[.[] | select(type == "object")
               | select(.type == "event_msg")
               | select(.payload.type == "user_message"
                        or (.payload.type == "item_completed"
                            and (.payload.item | type) == "object"
                            and .payload.item.type == "UserMessage"))] | length' "$1"
}

extract_codex() {
  local files before after oldest file rows extracted counts mute_files

  [ -d "$CODEX_ROOT" ] || {
    add_warning "Codex log root not found: $(short_path "$CODEX_ROOT")"
    add_source_stat "codex" "$CODEX_ROOT" "missing" 0 0 "event" "unknown"
    return
  }

  files="$(command find "$CODEX_ROOT" -type f -name 'rollout-*.jsonl' | wc -l | tr -d ' ')"
  oldest="$(oldest_file_date "$CODEX_ROOT" 'rollout-*.jsonl')"
  before="$(day_record_count)"
  rows="$(mktemp -t skill-session-digest-codex-rows)"
  extracted="$(mktemp -t skill-session-digest-codex-extracted)"
  mute_files=0

  # 新旧の rollout 形式を別関数に分けないのは、session_meta の親子判定・時刻・cwd の
  # 扱いが両形式で完全に共通で、分けると同じ除外ロジックを二重に持つことになるため。
  while IFS= read -r -d '' file; do
    awk 1 "$file" | jq -c -R 'fromjson? // empty' > "$rows"
    jq -cs --argjson off "$OFFSET_SECONDS" --arg day "$DAY" '
          def localpart($value; $fmt): ($value[0:19] + "Z" | fromdateiso8601 + $off | strftime($fmt));
          def call_arg:
            if .payload.name == "exec_command" or .payload.name == "shell_command" then
              ((.payload.arguments | fromjson? | .cmd) // "")
            else "" end;
          # 新形式の custom_tool_call は name が一律 "exec" で、実際の道具は input の
          # JS 風ソース（`await tools.exec_command({...})`）の中にしか無い。
          # input 全体を fromjson で読まないのは、実測で引数がクォート無しキーの
          # オブジェクトリテラルで整形されている系統があり（`{\n  cmd: "…"\n}`）、
          # JSON として解釈できないため。cmd の値だけを JSON 文字列リテラルとして
          # 取り出せば、両系統ともエスケープ込みで復元できる（実測 69/69 件）。
          #
          # 道具名の走査前に文字列リテラルを落とすのは、apply_patch のパッチ本文が
          # 呼び出しより前に置かれるため（実測 15/15 が
          # `const patch = "…"; text(await tools.apply_patch(patch));`）。本文に
          # `await tools.exec_command(` の文字列が入ると最初の一致がそちらになり、実際は
          # 編集なのに Bash の幻レコードが出る。このスクリプト自身のコメントがその文字列を
          # 含むので、自分を Codex で編集した時点で発火する。逆向き（cmd に
          # `tools.apply_patch(` を含むシェル実行が select で丸ごと落ちて黙って欠ける）も
          # 同じ根。呼び出し形まで要求するのは、strip 後も本文以外の言及が残りうるため。
          # 実測 170/170 で strip 前の判定と一致し、いずれも呼び出し 1 件に収束する。
          def inner_tool($input):
            [$input | gsub("\"(?:[^\"\\\\]|\\\\.)*\""; "")
                    | scan("tools\\.([A-Za-z_0-9]+)\\s*\\(")]
            | first // []
            | (if type == "array" then (.[0] // "") else . end);
          def inner_cmd($input):
            [$input | match("\\bcmd\\b\"?\\s*:\\s*(\"(?:[^\"\\\\]|\\\\.)*\")"; "g")
                    | .captures[0].string]
            | first // ""
            | (fromjson? // "");
          # item を直接索引しないのは、非オブジェクトで来たとき jq が索引エラーを投げ、
          # 下の changes と同じく digest 全体が exit 5 で沈黙するため。片方だけ守ると
          # 次に読む人がどちらが方針か判断できないので、item と changes で揃える。
          def item_type:
            if (.payload.item | type) == "object" then (.payload.item.type // "") else "" end;
          . as $rows
          | ([$rows[] | select(.type == "session_meta") | .payload] | first) as $meta
          | select($meta != null)
          | select(($meta.source | type) != "object")
          | select(($meta.parent_thread_id // null) == null and ($meta.agent_path // null) == null)
          | ({k: "a", source: "codex", sid: ($meta.id // ""), title: ""}),
            ($rows[]
             | select((.timestamp | type) == "string")
             | select(localpart(.timestamp; "%Y-%m-%d") == $day)
             | if .type == "event_msg" and .payload.type == "user_message" then
                 {k: "p", source: "codex", precision: "event",
                  time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                  cwd: ($meta.cwd // ""), br: ($meta.git.branch // ""), sid: ($meta.id // ""),
                  text: (.payload.message // "")}
                 | select((.text | length) > 0)
               elif .type == "event_msg" and .payload.type == "item_completed"
                    and item_type == "UserMessage" then
                 # response_item/message の role=user を使わないのは、AGENTS.md の
                 # 注入や環境情報が同じ形で混ざり、人間の発話と区別できないため。
                 ([.payload.item.content[]? | select(.type == "text") | .text // ""]
                  | join("\n")) as $text
                 | {k: "p", source: "codex", precision: "event",
                    time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                    cwd: ($meta.cwd // ""), br: ($meta.git.branch // ""), sid: ($meta.id // ""),
                    text: $text}
                 | select((.text | length) > 0)
               elif .type == "event_msg" and .payload.type == "item_completed"
                    and item_type == "FileChange" then
                 # 型を確かめてから keys を取るのは、changes が配列で来たとき jq の keys が
                 # エラーではなく整数の添字を静かに返すため。arg が数値になり、離れた最終
                 # jq の is_ephemeral で初めて落ちる（実測 exit 5・stdout 空・エラー文に
                 # Codex も FileChange も出ない）。1 ソースの異常で全体を殺さない方針に反する。
                 (.payload.item.changes // {} | select(type == "object") | keys[]) as $path
                 | {k: "t", source: "codex", precision: "event",
                    time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                    cwd: ($meta.cwd // ""), sid: ($meta.id // ""), name: "Edit", arg: $path}
               elif .type == "response_item" and .payload.type == "function_call" then
                 {k: "t", source: "codex", precision: "event",
                  time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                  cwd: ($meta.cwd // ""), sid: ($meta.id // ""),
                  name: (if .payload.name == "exec_command" or .payload.name == "shell_command" then "Bash"
                         elif .payload.name == "apply_patch" then "Edit" else (.payload.name // "?") end),
                  arg: call_arg}
               elif .type == "response_item" and .payload.type == "custom_tool_call"
                    and .payload.name == "exec" then
                 (.payload.input // "" | tostring) as $input
                 | inner_tool($input) as $inner
                 # apply_patch をここで数えないのは、同じ編集が item_completed の
                 # FileChange に変更ファイル単位で出るため。両方数えると Edit が二重に
                 # なる（実測: 親セッションで apply_patch 12 件・FileChange の変更パス
                 # 22 件）。かわりにパッチ本文のヘッダから拾う手も採らない。1 パッチが
                 # 複数ファイルを触るので先頭 1 件しか復元できず、files_touched が
                 # 実測で 45〜79% 落ちる。
                 | select($inner != "apply_patch")
                 | {k: "t", source: "codex", precision: "event",
                    time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                    cwd: ($meta.cwd // ""), sid: ($meta.id // ""),
                    name: (if $inner == "exec_command" then "Bash"
                           elif $inner == "" then "?" else $inner end),
                    arg: (if $inner == "exec_command" then inner_cmd($input) else "" end)}
               elif .type == "response_item" and .payload.type == "custom_tool_call" then
                 (.payload.input // "") as $input
                 | {k: "t", source: "codex", precision: "event",
                    time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                    cwd: ($meta.cwd // ""), sid: ($meta.id // ""),
                    name: (if .payload.name == "apply_patch" then "Edit" else (.payload.name // "?") end),
                    arg: (if .payload.name == "apply_patch" then
                            ([ $input | scan("\\*\\*\\* (?:Add|Update|Delete) File: ([^\\n]+)") ]
                             | first // "" | if type == "array" then .[0] else . end)
                          else "" end)}
               elif .type == "response_item" and .payload.type == "web_search_call" then
                 {k: "t", source: "codex", precision: "event",
                  time: localpart(.timestamp; "%H:%M"), hour: localpart(.timestamp; "%H"),
                  cwd: ($meta.cwd // ""), sid: ($meta.id // ""), name: "web_search", arg: ""}
               else empty end)
        ' "$rows" > "$extracted"

    # records が非 0 なら健全、とは見なせない。実測（2026-09-01）の新形式では
    # function_call / custom_tool_call は旧形式のまま拾えるのに user_message だけが
    # 別イベントへ移り、tool 61 件・prompt 0 件で通ってしまった。日報は発話が主語なので、
    # この状態は「その日 Codex を使っていない」と同じ顔をしてはいけない。
    counts="$(jq -s -r '[([.[] | select(.k == "t")] | length),
                         ([.[] | select(.k == "p")] | length)] | join(" ")' "$extracted")"
    if [ "${counts%% *}" -gt 0 ] && [ "${counts##* }" -eq 0 ] \
       && [ "$(codex_prompt_lines "$rows")" -eq 0 ]; then
      mute_files=$((mute_files + 1))
    fi

    command cat "$extracted" >> "$RECORDS"
  done < <(command find "$CODEX_ROOT" -type f -name 'rollout-*.jsonl' -print0)

  rm -f "$rows" "$extracted"
  after="$(day_record_count)"
  add_source_stat "codex" "$CODEX_ROOT" "available" "$files" "$((after - before))" "event" "$oldest"

  if [ "$mute_files" -gt 0 ]; then
    add_warning "codex: $DAY のツール実行を記録した rollout $mute_files 件に発話行が 1 つも無い（形式変更の可能性）"
  fi
}

selected "claude" && extract_claude
selected "cursor" && extract_cursor
selected "codex" && extract_codex

# ログはあるのに 1 件も拾えないソースを申告させる。各ソースの内部形式はこちらの管理外で、
# 変わったときは黙って 0 件になる（実測: session_meta を持たない rollout は
# status=available・records=0・warnings 空のまま落ちる）。ヘッダが避けようとしている
# 「入力が沈黙したまま、それらしい出力が出る」劣化そのものなので、必ず表に出す。
while IFS=$'\t' read -r source root pattern; do
  [ "$(files_touched_on_day "$root" "$pattern")" -gt 0 ] || continue
  add_warning "$source: $DAY に更新されたログはあるが 0 件しか抽出できなかった（形式変更の可能性）"
done < <(jq -r --arg claude "$CLAUDE_ROOT" --arg cursor "$CURSOR_ROOT" --arg codex "$CODEX_ROOT" '
  select(.status == "available" and .records == 0)
  | [.source,
     (if .source == "claude" then $claude elif .source == "cursor" then $cursor else $codex end),
     (if .source == "codex" then "rollout-*.jsonl" else "*.jsonl" end)]
  | @tsv' "$SOURCE_STATS")

# 1 ソースの欠落では止めない。3 エージェントのうち使っていないものは日常的に存在し、
# そこで exit すると「その日に本当に作業していない」場合と区別が付かなくなる。
# 全滅のときだけ落として、部分欠落は warnings で日報側に伝える。
RESOLVED="$(jq -s '[.[] | select(.status == "available")] | length' "$SOURCE_STATS")"
if [ "$RESOLVED" -eq 0 ]; then
  echo "no selected session log source is available" >&2
  exit 1
fi

# cwd をそのままプロジェクトにすると、リポジトリ内でディレクトリを移動しただけで
# 別プロジェクトが生える（実測では 1 つのリポジトリが terraform / environments /
# staging / production など 7 個に分裂した）。git のトップレベルに寄せて畳む。
# これがソースを跨いだ統合も兼ねる（同じ repo を Claude と Cursor で触っても 1 行）。
CWD_ROOTS="$(jq -r 'select(.cwd != null and .cwd != "") | .cwd' "$RECORDS" | sort -u \
  | while IFS= read -r dir; do
      printf '%s\t%s\n' "$dir" "$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir")"
    done \
  | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {(.[0]): .[1]}) | add // {}')"

SOURCE_STATS_JSON="$(jq -s '.' "$SOURCE_STATS")"
WARNINGS_JSON="$(jq -s '.' "$WARNINGS")"

jq -s \
  --arg day "$DAY" --arg tz "$TZ_NAME" --arg home "$HOME" --arg requested "$SOURCE" \
  --argjson chars "$MAX_PROMPT_CHARS" --argjson noise "$NOISE_PREFIXES" \
  --argjson roots "$CWD_ROOTS" --arg project "$PROJECT" \
  --argjson source_stats "$SOURCE_STATS_JSON" --argjson warnings "$WARNINGS_JSON" '
  map(if (.cwd | type) == "string" then .cwd = ($roots[.cwd] // .cwd) else . end)
  # --project は畳んだ後のパスに掛ける。出力に出るプロジェクト名でそのまま絞れないと、
  # ユーザーが見えている名前（例: dev-local-scripts）で 0 件になる。
  | map(select(.k == "a" or $project == "" or ((.cwd // "") | contains($project))))
  | def home_short:
      if startswith($home) then "~" + .[($home | length):] else . end;
  # 一時ディレクトリは「プロジェクト」でも「触ったファイル」でもない。scratchpad は
  # セッション毎に切られるため、除外しないと日報に毎日ちがう偽プロジェクトが並ぶ。
  def is_ephemeral:
    startswith("/tmp/") or startswith("/private/tmp/")
    or startswith("/var/folders/") or startswith("/private/var/folders/")
    or contains("/scratchpad");
  def trunc($n): if length > $n then .[0:$n] + " …[truncated]" else . end;
  def trimmed: sub("^[\\s\\u3000]+"; "") | sub("[\\s\\u3000]+$"; "");
  def is_noise:
    . as $text
    | length == 0
      or ([$noise[] | select(. as $prefix | $text | startswith($prefix))] | length) > 0
      or ((sub("[.,!?。、！？\\s]+$"; "") | ascii_downcase)
          | . == "y" or . == "yes" or . == "ok" or . == "okay" or . == "done" or . == "はい");

  # セッション ID はソース毎に採番されるため、キーを sid だけにすると別エージェントの
  # 同名セッションでタイトルが上書きされうる。source を前置して名前空間を分ける。
  ([.[] | select(.k == "a")] | map({((.source + ":" + .sid)): .title}) | add // {}) as $titles
  | [.[] | select(.k == "t")] as $tools
  | [.[] | select(.k == "p") | .text |= trimmed] as $raw_prompts
  # セッションを再開すると過去のやり取りが新しいファイルにも書き戻され、同一発話が
  # 複数ファイルに現れる（実測で同じ prompt が 2 回計上された）。時刻＋本文で潰す。
  # source をキーに含めるのは、別エージェントで同じ指示を出した場合は別の作業であり、
  # 潰すと「両方で試した」という事実が消えるため。
  | ([$raw_prompts[] | select((.text | is_noise) | not) | .text |= trunc($chars)]
     | unique_by([.source, .cwd, .time, .text])) as $prompts
  | ([$prompts[].cwd, $tools[].cwd]
     | map(select(type == "string" and . != "" and (is_ephemeral | not))) | unique) as $cwds
  | {
      meta: {
        # 単一ソース前提の meta.source / files_scanned を source_stats へ置き換えたため、
        # 旧 digest JSON を読むスキル側が黙って誤読しないよう版を明示する。
        schema_version: 2,
        date: $day,
        timezone: $tz,
        sources_requested: $requested,
        sources_resolved: ([$source_stats[] | select(.status == "available") | .source]),
        source_stats: $source_stats,
        warnings: $warnings,
        retention_oldest: ([$source_stats[].retention_oldest | select(. != "unknown")] | min // "unknown"),
        prompt_truncated_at: $chars
      },
      stats: {
        prompts_total: ($raw_prompts | length),
        prompts_kept: ($prompts | length),
        projects: ($cwds | length),
        sessions: ([$prompts[] | [.source, .sid]] | unique | length),
        tool_calls: ($tools | length),
        # Cursor は発話時刻を持たないので hour が空になる。0 時などに丸めて混ぜると
        # 稼働時間帯の山・谷という by_hour の唯一の用途が壊れるため、集計から外す。
        by_hour: ([$prompts[] | select(.hour != "") | .hour]
                  | group_by(.) | map({key: .[0], value: length}) | from_entries),
        tools: ([$tools[].name] | group_by(.) | map({key: .[0], value: length})
                | sort_by(-.value) | from_entries)
      },
      projects: [
        $cwds[] as $cwd
        | ([$prompts[] | select(.cwd == $cwd)]) as $project_prompts
        | ([$tools[] | select(.cwd == $cwd)]) as $project_tools
        | {
            cwd: ($cwd | home_short),
            name: ($cwd | split("/") | last),
            sources: ([$project_prompts[].source, $project_tools[].source] | unique),
            time_precision: ([$project_prompts[].precision, $project_tools[].precision] | unique),
            branches: ([$project_prompts[].br] | map(select(. != "")) | unique),
            sessions: ([$project_prompts[], $project_tools[]]
                       | unique_by([.source, .sid])
                       | map({source, id: (.sid[0:8]), title: ($titles[.source + ":" + .sid] // "")})),
            # span は event 精度のレコードだけから出す。session / file 精度の時刻を
            # 混ぜると、Cursor のセッション 1 点が稼働の開始・終了として通ってしまい、
            # precision を分けた意味が span で消える。粗い時刻は捨てず
            # span_low_precision に分けて出し、日報側で扱いを変えられるようにする。
            span: {
              from: ([$project_prompts[], $project_tools[]]
                     | map(select(.precision == "event") | .time) | min),
              to: ([$project_prompts[], $project_tools[]]
                   | map(select(.precision == "event") | .time) | max)
            },
            span_low_precision: {
              from: ([$project_prompts[], $project_tools[]]
                     | map(select(.precision != "event") | .time) | min),
              to: ([$project_prompts[], $project_tools[]]
                   | map(select(.precision != "event") | .time) | max)
            },
            tools: ([$project_tools[].name] | group_by(.) | map({key: .[0], value: length})
                    | sort_by(-.value) | from_entries),
            git_commands: ([$project_tools[] | select(.name == "Bash" and (.arg | startswith("git ")))
                            | .arg | gsub("\\s+"; " ") | trunc(200)] | unique | .[0:40]),
            files_touched: ([$project_tools[]
                              | select(.name == "Edit" or .name == "Write" or .name == "NotebookEdit")
                              | .arg | select(. != "" and (is_ephemeral | not)) | home_short]
                            | unique | .[0:30]),
            prompts: ([$project_prompts[] | {source, time, precision, text}] | sort_by(.time, .source))
          }
        | select((.prompts | length) > 0 or (.tools | length) > 0)
      ] | sort_by(-(.prompts | length))
    }
  ' "$RECORDS"
