#!/usr/bin/env bash

# PR に既に投稿されているレビュー状態を、再レビュー時の照合用に正規化して返す。
#
# 現行の SKILL.md は REST `pulls/{pr}/comments --paginate` だけを使っていたが、
# このエンドポイントは isResolved / isOutdated / thread の概念を一切返さない。
# 実測（fastmedia/signa#223）では 52 thread 中 47 が解決済み・26 が outdated で、
# 「人間が対応不要と判断した論点」が再レビュー側から完全に不可視だった。これが
# 同じ PR を2回レビューしたときに前回と矛盾する主因。
#
# reviewThreads だけでは、レビュー要約（review 本体の body）も拾えない。実測
# （同 PR）では gemini-code-assist の 541 文字のレビューが threads にも会話欄にも
# 現れず、bot が既に指摘した論点を人間が2度読まされる状態だった。reviews も取る。
#
# 判断（同一性の最終判定・重大度・仕様適合）は持ち込まない。状態を集めるだけ。
#
# Usage:
#   skill-review-state <owner/repo> <pr-number> [--me <login>]
#
# Output: stdout に JSON 1 オブジェクト
#   me              自分の login
#   threads[]       レビュースレッド
#     path, line, original_line, is_resolved, is_outdated
#     author        先頭コメントの投稿者（login を正規化したもの）
#     is_bot        先頭コメントが bot の投稿か（gemini-code-assist 等）
#     mine          先頭コメントが自分の投稿か
#     badged        先頭コメントに shields.io の review バッジがあるか（AI 投稿の判別子）
#     has_human_reply 自分以外の人間の返信が付いているか
#     has_bot_reply   bot の返信が付いているか
#     first_comment_id / body_head  返信先の特定と観点の突き合わせ用
#   reviews[]       レビュー要約（login, is_bot, state, submitted_at, body_head）
#   omitted_inline_only_reviews
#                   body 空 かつ state == COMMENTED の review を落とした件数。
#                   これは inline コメントを束ねる封筒で、実体は threads[] に既出。
#                   実測 #223 では 68 件中 60 件がこれで、残すと「同一人物が 60 回
#                   レビュー＝議論が活発」という誤読を誘う。落ちた事実だけ数で残す。
#   issue_comments[] PR 会話欄のコメント。「対応不要」がここに書かれることがあり、
#                    レビュースレッドだけ見ていると必ず見落とす。
#
# login はソース間で表記が割れる（REST は `gemini-code-assist[bot]`、GraphQL は
# `gemini-code-assist`）。同じレビュアーの review 本文と inline 指摘を突き合わせる
# 用途で必ず空振りするため、出力では末尾 `[bot]` を落として1つの名前空間に寄せる。
# bot 判定は login のサフィックスではなく型で行う（REST は user.type、GraphQL は
# __typename）。人間が `foo[bot]` という名前を取れる余地を残さないため。

set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: skill-review-state <owner/repo> <pr-number> [--me <login>]" >&2
  exit 2
fi

repo="$1"; pr="$2"; shift 2
me=""
while [ $# -gt 0 ]; do
  case "$1" in
    --me) me="${2:-}"; shift 2 ;;
    *)    echo "不明な引数: $1" >&2; exit 2 ;;
  esac
done

owner="${repo%%/*}"
name="${repo##*/}"
if [ -z "$owner" ] || [ -z "$name" ] || [ "$owner" = "$name" ]; then
  echo "リポジトリは owner/repo 形式で指定してください: $repo" >&2
  exit 2
fi

[ -n "$me" ] || me="$(gh api user -q .login)"

# reviewThreads も、その配下の comments も、どちらも pageInfo を辿らないと
# 黙って1ページ目だけが返る。返信が 100 件を超えるスレッドでは、人間が後から
# 書いた「対応不要」を取りこぼす。両方のカーソルを明示的に回す。
#
# 初回カーソルは `-F cursor=null`（JSON の null）で渡す。`-f cursor="null"` は
# 文字列 "null" を不正なカーソルとして送りつけ、GitHub は 1 ページ目の先頭
# スレッドを黙って落として返す（実測 #223: totalCount 52 に対し 51 件しか返らず、
# 落ちたのは bot が立てて人間が返信したスレッドだった）。2 ページ目以降の実カーソルは
# base64 文字列なので `-f` で渡す。`-F` に通すと数値・真偽値に見える値を
# JSON リテラルとして解釈されうるため、両者を混ぜない。
threads='[]'
threads_total=""
cursor=""
while :; do
  if [ -z "$cursor" ]; then
    cursor_arg=(-F cursor=null)
  else
    cursor_arg=(-f cursor="$cursor")
  fi

  page="$(gh api graphql \
    -f owner="$owner" -f name="$name" -F number="$pr" "${cursor_arg[@]}" \
    -f query='
      query($owner:String!, $name:String!, $number:Int!, $cursor:String) {
        repository(owner:$owner, name:$name) {
          pullRequest(number:$number) {
            reviewThreads(first:100, after:$cursor) {
              totalCount
              pageInfo { hasNextPage endCursor }
              nodes {
                isResolved isOutdated path line originalLine
                comments(first:100) {
                  pageInfo { hasNextPage endCursor }
                  nodes { databaseId body author { login __typename } }
                }
              }
            }
          }
        }
      }')"

  printf '%s' "$page" | jq -e '.data.repository.pullRequest' >/dev/null 2>&1 || {
    echo "PR を取得できません: $repo#$pr" >&2
    printf '%s' "$page" | jq -r '.errors[]?.message // empty' >&2
    exit 1
  }

  threads="$(jq -n \
    --argjson acc "$threads" \
    --argjson page "$(printf '%s' "$page" | jq '.data.repository.pullRequest.reviewThreads.nodes')" \
    '$acc + $page')"

  threads_total="$(printf '%s' "$page" | jq -r '.data.repository.pullRequest.reviewThreads.totalCount')"

  has_next="$(printf '%s' "$page" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage')"
  [ "$has_next" = "true" ] || break
  cursor="$(printf '%s' "$page" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor')"
done

# 取得漏れは黙って通すと「そのスレッドは存在しない」と読まれ、settled 済みの論点を
# 再提起する。件数が合わなければ警告する（上記のカーソル不正は実測で1件だけ落ちた）。
threads_got="$(printf '%s' "$threads" | jq 'length')"
if [ -n "$threads_total" ] && [ "$threads_got" != "$threads_total" ]; then
  echo "警告: reviewThreads の取得数 $threads_got が totalCount $threads_total と一致しません" >&2
fi

# review は push ごとに積まれ、bot が再レビューする PR では 100 を超える
# （実測 #223 で totalCount 68）。1ページで足りると仮定せず --paginate する。
reviews="$(gh api "repos/$repo/pulls/$pr/reviews" --paginate \
  --jq '[.[] | {login: .user.login, is_bot: (.user.type == "Bot"), state, submitted_at, body}]' \
  | jq -sc 'add // []')"

issue_comments="$(gh api "repos/$repo/issues/$pr/comments" --paginate \
  --jq '[.[] | {id, login: .user.login, is_bot: (.user.type == "Bot"), body}]' \
  | jq -sc 'add // []')"

jq -n \
  --arg me "$me" \
  --argjson threads "$threads" \
  --argjson reviews "$reviews" \
  --argjson issue_comments "$issue_comments" \
  '
  def bare: (. // "") | sub("\\[bot\\]$"; "");
  ($me | bare) as $me_bare |
  ($reviews | map(select(((.body // "") != "") or (.state != "COMMENTED")))) as $kept_reviews |
  {
    me: $me_bare,
    threads: ($threads | map(
      (.comments.nodes[0] // {}) as $head |
      {
        path, line, original_line: .originalLine,
        is_resolved: .isResolved,
        is_outdated: .isOutdated,
        first_comment_id: ($head.databaseId // null),
        author: ($head.author.login | bare),
        is_bot: (($head.author.__typename // "") == "Bot"),
        mine: (($head.author.login | bare) == $me_bare),
        badged: (($head.body // "") | test("img\\.shields\\.io/badge/review-")),
        # bot の返信を人間の議論とみなすと、gemini が1件返信しただけで
        # 「議論中だから触らない」と誤抑止する。人間と bot を分けて出す。
        has_human_reply: ([.comments.nodes[1:][]
          | select((.author.__typename // "") != "Bot")
          | select((.author.login | bare) != $me_bare)] | length > 0),
        has_bot_reply: ([.comments.nodes[1:][]
          | select((.author.__typename // "") == "Bot")] | length > 0),
        # 返信が 100 件を超えるスレッドは、その事実を落とさず truncated_replies で
        # 伝える。黙って切ると「人間の返信が無い」と誤判定して再提起してしまう。
        truncated_replies: .comments.pageInfo.hasNextPage,
        body_head: (($head.body // "")[0:400])
      })),
    reviews: ($kept_reviews | map({
      login: (.login | bare),
      is_bot,
      state,
      submitted_at,
      body_head: ((.body // "")[0:400])
    })),
    omitted_inline_only_reviews: (($reviews | length) - ($kept_reviews | length)),
    issue_comments: ($issue_comments | map(.login |= bare))
  }'
